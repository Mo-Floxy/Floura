# FLOURA configuration (copy to .env)
PORT=3001
NODE_ENV=development

# Frontend origin, used for CORS and links in emails
CLIENT_URL=http://localhost:5173

# Optional: set a stable secret in production (a generated one is stored in server/data/.jwt-secret otherwise)
JWT_SECRET=replace-with-a-long-random-string

# Optional: SQLite database location (defaults to server/data/floura.db)
# DB_PATH=/path/to/floura.db

# Optional email delivery. Without this, verification and reset tokens are returned in API responses for local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASS=your-password
# SMTP_FROM="FLOURA <no-reply@floura.app>"

# Set to true when serving HTTPS behind a proxy so auth cookies are marked Secure
# HTTPS=true
